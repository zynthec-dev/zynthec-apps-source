/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Access-Control-Allow-Origin: *
  Content-Security-Policy: default-src 'self'; img-src 'self' https://apps.zynthec.com; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
/source.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300
/admin
  Cache-Control: no-store
/admin.html
  Cache-Control: no-store
/admin.js
  Cache-Control: no-store

/
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/index.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/zynthecApp.mobileconfig
  Content-Type: application/x-apple-aspen-config
  Content-Disposition: attachment; filename="zynthecApp.mobileconfig"

/install/*.plist
  Content-Type: application/xml
  Cache-Control: no-store
/installations.json
  Cache-Control: no-store
/install.html
  Cache-Control: no-store
